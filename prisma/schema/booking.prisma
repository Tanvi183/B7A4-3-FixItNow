model Booking {
  id                    String          @id @default(uuid())
  customerId            String
  serviceId             String
  bookingDate           DateTime
  timeSlot              String
  status                BookingStatus   @default(requested)
  totalAmount           Decimal
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  adminNote             String?
  assignedAt            DateTime?
  customerConfirmedAt   DateTime?
  customerFeedback      String?
  requestedAt           DateTime        @default(now())
  technicianId          String?
  technicianNote        String?
  technicianRespondedAt DateTime?
  cancellationOffer     Decimal?
  cancellationReason    String?
  workCompletedAt       DateTime?
  customer              User            @relation("CustomerBookings", fields: [customerId], references: [id], onDelete: Cascade)
  service               Service         @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  technician            User?           @relation("TechnicianBookings", fields: [technicianId], references: [id])
  payment               Payment?
  review                Review?
  statusHistory         StatusHistory[]

  @@map("bookings")
}
