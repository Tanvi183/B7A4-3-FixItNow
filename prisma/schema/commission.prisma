model CommissionSplit {
  id               String   @id @default(uuid())
  paymentId        String   @unique
  technicianId     String
  totalAmount      Decimal
  commissionRate   Decimal
  platformAmount   Decimal
  technicianAmount Decimal
  createdAt        DateTime @default(now())
  payment          Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@map("commission_splits")
}

model TechnicianPayout {
  id           String    @id @default(uuid())
  technicianId String
  amount       Decimal
  status       String    @default("CREDITED")
  payoutMethod String?
  payoutDate   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  technician   User      @relation(fields: [technicianId], references: [id], onDelete: Cascade)

  @@map("technician_payouts")
}
