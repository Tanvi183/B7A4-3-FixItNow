model CommissionSplit {
  id               String   @id @default(uuid())
  paymentId        String   @unique
  payment          Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  technicianId     String
  totalAmount      Decimal
  commissionRate   Decimal  // e.g. 0.20
  platformAmount   Decimal
  technicianAmount Decimal
  createdAt        DateTime @default(now())

  @@map("commission_splits")
}

model TechnicianPayout {
  id             String   @id @default(uuid())
  technicianId   String
  technician     User     @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  amount         Decimal
  status         String   @default("CREDITED") // CREDITED, PAID_OUT
  payoutMethod   String?  // bank, stripe_connect, etc.
  payoutDate     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("technician_payouts")
}
